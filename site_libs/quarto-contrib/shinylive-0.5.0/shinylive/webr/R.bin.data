Package: webr
Title: WebR Support Package
Version: 0.4.0
Authors@R: c(
    person("George", "Stagg", , "george.stagg@posit.co", role = c("aut", "cre")),
    person("Lionel", "Henry", , "lionel@posit.co", role = "aut"),
