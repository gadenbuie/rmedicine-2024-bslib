CAex <-
    local({
	load(system.file(file.path("external", "CAex_slots.rda"), package = "Matrix"))
	## -> 'L'
	r <- methods::new("dgCMatrix")
	for (n in c("Dim", "i","p","x"))
	    methods::slot(r, n) <- L[[n]]
	r
    })

## The reverse { CAex |--> L } is
