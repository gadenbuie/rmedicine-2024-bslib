source(system.file("test-tools-Matrix.R", package = "Matrix"),
       keep.source = FALSE)

if(!exists("doExtras", mode="logical")) # << only if not set *before*
doExtras <- interactive() || nzchar(Sys.getenv("R_MATRIX_CHECK_EXTRA"))
