        "not": {
            "type": "object",
            "required": [ "id", "ids" ]
        }
    },

    "one_and_only_one_of_datum_or_datum_ensemble": {
      "allOf": [
        {
            "not": {
                "type": "object",
                "required": [ "datum", "datum_ensemble" ]
            }
        },
        {
            "oneOf": [
                { "type": "object", "required": ["datum"] },
                { "type": "object", "required": ["datum_ensemble"] }
            ]
        }
      ]
    },

